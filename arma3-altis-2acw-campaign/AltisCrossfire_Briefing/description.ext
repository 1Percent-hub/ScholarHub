// Altis Crossfire - Campaign Briefing Menu

// ---- Base UI classes ----

class RscText
{
    idc = -1;
    type = 0;
    style = 0;
    x = 0; y = 0; w = 0.1; h = 0.04;
    colorBackground[] = {0,0,0,0};
    colorText[] = {1,1,1,1};
    font = "PuristaMedium";
    sizeEx = 0.04;
    text = "";
    shadow = 1;
    linespacing = 1;
    fixedWidth = 0;
    deletable = 0;
    fade = 0;
    access = 0;
};

class RscStructuredText
{
    idc = -1;
    type = 13;
    style = 0;
    x = 0; y = 0; w = 0.1; h = 0.04;
    colorText[] = {1,1,1,1};
    colorBackground[] = {0,0,0,0};
    font = "PuristaMedium";
    size = 0.04;
    text = "";
    shadow = 1;
    deletable = 0;
    fade = 0;
    class Attributes
    {
        font = "PuristaMedium";
        color = "#ffffff";
        align = "left";
        shadow = 1;
    };
};

class RscButton
{
    idc = -1;
    type = 1;
    style = 2;
    x = 0; y = 0; w = 0.1; h = 0.04;
    text = "";
    font = "PuristaMedium";
    sizeEx = 0.04;
    colorText[] = {1,1,1,1};
    colorDisabled[] = {0.4,0.4,0.4,1};
    colorBackground[] = {0.2,0.2,0.2,0.9};
    colorBackgroundDisabled[] = {0.1,0.1,0.1,0.5};
    colorBackgroundActive[] = {0.3,0.3,0.3,1};
    colorFocused[] = {0.3,0.3,0.3,1};
    colorShadow[] = {0,0,0,0.5};
    colorBorder[] = {0,0,0,0};
    shadow = 0;
    offsetX = 0;
    offsetY = 0;
    offsetPressedX = 0.002;
    offsetPressedY = 0.002;
    borderSize = 0;
    soundEnter[] = {"",0.1,1};
    soundPush[] = {"",0.1,1};
    soundClick[] = {"",0.1,1};
    soundEscape[] = {"",0.1,1};
    deletable = 0;
    fade = 0;
};

class RscControlsGroup
{
    idc = -1;
    type = 15;
    style = 16;
    x = 0; y = 0; w = 1; h = 1;
    deletable = 0;
    fade = 0;
    class VScrollbar
    {
        color[] = {1,1,1,0.4};
        width = 0.021;
        autoScrollEnabled = 0;
        autoScrollSpeed = -1;
        autoScrollDelay = 5;
        autoScrollRewind = 0;
        shadow = 0;
    };
    class HScrollbar
    {
        color[] = {1,1,1,0};
        height = 0;
    };
    class Controls {};
};

// ---- Campaign Briefing Dialog ----

class RscDisplayAltisCrossfireBriefing
{
    idd = 7300;
    movingEnable = 0;
    enableSimulation = 1;

    class controls
    {
        // Full-screen black overlay (dims everything behind the menu)
        class BlackOverlay: RscText
        {
            idc = -1;
            x = 0;
            y = 0;
            w = 1;
            h = 1;
            colorBackground[] = {0,0,0,0.92};
            text = "";
        };

        // Menu panel (larger box)
        class Background: RscText
        {
            idc = -1;
            x = 0.04;
            y = 0.02;
            w = 0.92;
            h = 0.96;
            colorBackground[] = {0.07,0.07,0.11,0.97};
        };

        class Title: RscText
        {
            idc = -1;
            x = 0.06;
            y = 0.035;
            w = 0.88;
            h = 0.07;
            text = "ALTIS CROSSFIRE";
            sizeEx = 0.068;
            colorText[] = {1,0.85,0.4,1};
            font = "PuristaBold";
        };
        class Subtitle: RscText
        {
            idc = -1;
            x = 0.06;
            y = 0.105;
            w = 0.88;
            h = 0.04;
            text = "A 2ACW Storyline on Altis  |  Read the tabs below, then close when ready.";
            sizeEx = 0.038;
            colorText[] = {0.7,0.75,0.85,0.9};
        };

        // ---- Tab buttons (bigger) ----
        class BtnLore: RscButton
        {
            idc = 7310;
            x = 0.06;
            y = 0.155;
            w = 0.19;
            h = 0.048;
            text = "Lore / Storyline";
            sizeEx = 0.042;
            colorBackground[] = {0.35,0.4,0.55,1};
            colorBackgroundActive[] = {0.45,0.5,0.65,1};
            colorFocused[] = {0.35,0.4,0.55,1};
            action = "['lore'] call ACW_fnc_briefingTab;";
        };
        class BtnCharacters: RscButton
        {
            idc = 7311;
            x = 0.26;
            y = 0.155;
            w = 0.16;
            h = 0.048;
            text = "Characters";
            sizeEx = 0.042;
            colorBackground[] = {0.2,0.25,0.35,0.9};
            colorBackgroundActive[] = {0.45,0.5,0.65,1};
            colorFocused[] = {0.2,0.25,0.35,0.9};
            action = "['chars'] call ACW_fnc_briefingTab;";
        };
        class BtnFactions: RscButton
        {
            idc = 7312;
            x = 0.43;
            y = 0.155;
            w = 0.14;
            h = 0.048;
            text = "Factions";
            sizeEx = 0.042;
            colorBackground[] = {0.2,0.25,0.35,0.9};
            colorBackgroundActive[] = {0.45,0.5,0.65,1};
            colorFocused[] = {0.2,0.25,0.35,0.9};
            action = "['missions_arc'] call ACW_fnc_briefingTab;";
        };
        class BtnMissions: RscButton
        {
            idc = 7314;
            x = 0.58;
            y = 0.155;
            w = 0.14;
            h = 0.048;
            text = "Missions";
            sizeEx = 0.042;
            colorBackground[] = {0.2,0.25,0.35,0.9};
            colorBackgroundActive[] = {0.45,0.5,0.65,1};
            colorFocused[] = {0.2,0.25,0.35,0.9};
            action = "['missions'] call ACW_fnc_briefingTab;";
        };

        // ---- Scrollable content area (bigger, more room to read) ----
        class ContentGroup: RscControlsGroup
        {
            idc = 7303;
            x = 0.06;
            y = 0.215;
            w = 0.88;
            h = 0.72;

            class Controls
            {
                class ContentText: RscStructuredText
                {
                    idc = 7302;
                    x = 0;
                    y = 0;
                    w = 0.848;
                    h = 5;
                    size = 0.042;
                    colorBackground[] = {0.05,0.05,0.08,0.5};
                    class Attributes
                    {
                        font = "PuristaMedium";
                        color = "#e8e8e8";
                        align = "left";
                        shadow = 0;
                    };
                };
            };
        };

        // ---- Close button (bigger) ----
        class BtnClose: RscButton
        {
            idc = 7313;
            x = 0.78;
            y = 0.94;
            w = 0.16;
            h = 0.05;
            text = "CLOSE";
            sizeEx = 0.048;
            font = "PuristaBold";
            colorBackground[] = {0.3,0.15,0.15,0.9};
            colorBackgroundActive[] = {0.5,0.2,0.2,1};
            colorFocused[] = {0.3,0.15,0.15,0.9};
            action = "closeDialog 0;";
        };
    };
};
